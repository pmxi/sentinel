[Unit]
Description=Sent private email web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/sent/current
EnvironmentFile=/opt/sent/app/.env
ExecStart=/usr/local/bin/node24 %h/sent/current/apps/server/dist/index.js
Restart=always
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
