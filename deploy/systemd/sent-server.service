[Unit]
Description=Sent private email web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/sent/current
EnvironmentFile=/opt/sent/app/.env
ExecStart=%h/sent/bin/sent-run server
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
