[Unit]
Description=Sent private email web service
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/sent/app
EnvironmentFile=/opt/sent/app/.env
ExecStart=/usr/local/bin/node24 /opt/sent/app/apps/server/dist/index.js
Restart=always
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
