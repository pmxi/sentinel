[Unit]
Description=Back up the Sent PostgreSQL database
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/
Environment=SENT_BACKUP_DIR=/opt/sent/backups
Environment=PGSERVICE=sent-backup
Environment=PGSERVICEFILE=/etc/sent/pg_service.conf
ExecStart=/usr/local/lib/sent/backup.sh
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/sent/backups
