[Unit]
Description=Back up the Sent PostgreSQL database
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/sent/app
EnvironmentFile=/opt/sent/app/.env
Environment=SENT_BACKUP_DIR=/opt/sent/backups
ExecStart=/opt/sent/app/deploy/backup-native.sh
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/sent/backups
