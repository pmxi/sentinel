[Unit]
Description=Back up the Sent PostgreSQL database
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/
EnvironmentFile=/opt/sent/app/.env
Environment=SENT_BACKUP_DIR=/opt/sent/backups
Environment=NODE_BIN=/usr/local/bin/node24
ExecStart=/usr/local/lib/sent/backup.sh
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/sent/backups
