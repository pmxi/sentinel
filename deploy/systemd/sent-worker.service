[Unit]
Description=Sent email synchronization and classification worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/sent/current
EnvironmentFile=/opt/sent/app/.env
ExecStart=/usr/local/bin/node24 %h/sent/current/apps/worker/dist/index.js
Restart=always
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
