# Sentinel configuration. Copy to .env and fill in — .env is gitignored.
#   cp .env.example .env

# ---- Required ----------------------------------------------------------

# PostgreSQL connection. Dev setup: see the README "Development" section.
DATABASE_URL=postgresql://you@localhost:5432/sentinel

# OpenAI API key for classification. (LLM_API_KEY is also accepted.)
OPENAI_API_KEY=sk-...

# Google OAuth client — powers "Sign in with Google" AND "Connect Gmail".
# Create a *Web application* client in Google Cloud Console, enable the Gmail
# API, and register the redirect URI below on it.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# ---- Recommended -------------------------------------------------------

# Flask session signing key. REQUIRED — the web app refuses to start without it.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# OAuth redirect URI — must exactly match one registered on the Google client.
# Dev default shown; use your https://.../oauth/google/callback in production.
GOOGLE_REDIRECT_URI=http://localhost:8765/oauth/google/callback

# ---- Classifier (optional; defaults shown) -----------------------------

LLM_MODEL=gpt-5.4-mini
LLM_REASONING_EFFORT=medium          # low | medium | high  (empty disables reasoning)

# ---- Web Push alerts (required) ----------------------------------------
# Alerts are delivered via Web Push to the installed PWA. Generate a VAPID
# keypair once and paste the output here:
#   python -m sentinel.scripts.gen_vapid_keys
# VAPID_SUBJECT must be a mailto: or https: contact the push services can reach.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Runtime (optional; defaults shown) --------------------------------

# LOG_LEVEL=INFO
# LOG_DIR=logs
# DISABLE_FILE_LOGGING=false
