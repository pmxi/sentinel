# Public URL used for OAuth callbacks (no trailing slash)
SENT_PUBLIC_URL=http://localhost:3000
# In development Vite serves the UI separately. Leave blank in production.
SENT_WEB_URL=http://localhost:5173
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://sent:sent@localhost:5432/sent

# Generate with: pnpm sent:hash-password
# Wrap the result in single quotes so Docker Compose preserves the dollar signs.
SENT_PASSWORD_HASH=
# Generate each with: openssl rand -base64 32
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

OPENAI_API_KEY=
OPENAI_CLASSIFICATION_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" supports personal and organizational Microsoft accounts.
MICROSOFT_TENANT_ID=common
# Enable only after the Microsoft tenant grants delegated Mail.Send.
MICROSOFT_MAIL_SEND_ENABLED=false

# Optional in development. Production Caddy serves the built frontend.
WEB_DIST_PATH=apps/web/dist
LOG_LEVEL=info
