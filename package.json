{
  "name": "sent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "concurrently -n web,server,worker -c cyan,green,magenta \"pnpm --filter @sent/web dev\" \"pnpm --filter @sent/server dev\" \"pnpm --filter @sent/worker dev\"",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:migrate": "pnpm --filter @sent/core db:migrate",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "pnpm -r --if-present lint",
    "sent:classify-latest": "tsx scripts/classify-latest.ts",
    "sent:embed-archive": "tsx scripts/embed-archive.ts",
    "sent:hash-password": "tsx scripts/hash-password.ts",
    "sent:repair-microsoft": "tsx scripts/repair-microsoft-delta-corruption.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/node": "^26.2.0",
    "argon2": "^0.45.1",
    "concurrently": "latest",
    "dotenv": "^17.4.2",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
